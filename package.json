{
  "name": "yiziview-next",
  "version": "0.1.0",
  "private": true,
  "description": "本地 ComfyUI 图片浏览器 + 分级筛选器（M0 骨架）",
  "type": "module",
  "main": "src/main/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && electron-builder --dir",
    "build:renderer": "vite build",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "lint": "eslint .",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/unit/*.test.mjs\""
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "chokidar": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tailwindcss": "^3.4.17",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "com.yiziview.next",
    "productName": "YiziViewNext",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/core/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir"
    }
  }
}
